# Server-side only. Never expose these to the browser or prefix with NEXT_PUBLIC_.
# Get a key at https://build.nvidia.com (free tier is fine).
NVIDIA_API_KEY=your-nvidia-api-key

# Model for the live conversation (/api/chat). Needs tool calling and low latency.
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Model for the structured post-call JSON (/api/summary). Needs JSON-schema output.
NVIDIA_SUMMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
